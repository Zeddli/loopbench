# Copy to a private service environment file. Never commit the filled file.
# Hosted admission remains disabled until the local preflight and deployment probes pass.
NODE_ENV=production
LOOPBENCH_HOSTED_ENABLED=false
LOOPBENCH_PUBLIC_ORIGIN=https://loopbench.example.com
LOOPBENCH_GATEWAY_ORIGIN=https://loopbench.example.com
# Set only when the application is bound to loopback behind the supplied Caddy
# rule, which overwrites X-Forwarded-For with the actual remote address.
LOOPBENCH_TRUSTED_PROXY_HEADERS=1
LOOPBENCH_HOSTED_DB_PATH=/var/lib/loopbench/hosted.sqlite
LOOPBENCH_PRIVATE_DATA_ROOT=/var/lib/loopbench/private
LOOPBENCH_SESSION_SIGNING_KEY=
LOOPBENCH_SESSION_SIGNING_KEY_ID=primary
LOOPBENCH_CREDENTIAL_FINGERPRINT_KEY=
LOOPBENCH_VAULT_KEYRING_FILE=/etc/loopbench/vault-keyring.json
# Worker/reaper compute controller for Token Factory Sandboxes; separate from browser BYOK.
LOOPBENCH_EXECUTION_PROVIDER=tokenfactory
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
LOOPBENCH_TOKEN_RUNNER_MANIFEST=/etc/loopbench/token-runner-manifest.json
# Platform E2B credential is required only in worker/reaper environments.
E2B_API_KEY=
LOOPBENCH_E2B_TEMPLATE_ID=
LOOPBENCH_RUNNER_MANIFEST=/etc/loopbench/runner-manifest.json
# Verified actual combined per-second USD rate for the manifest's CPU/memory profile.
# Do not paste an illustrative documentation rate without checking the account.
LOOPBENCH_E2B_USD_PER_SECOND=
LOOPBENCH_E2B_CPU_COUNT=
LOOPBENCH_E2B_MEMORY_MIB=
LOOPBENCH_E2B_LIMIT_EVIDENCE=/etc/loopbench/e2b-limit-evidence.json
# The user's Nebius key is connected through the HTTPS setup page and encrypted.
# There is no platform inference key or automatic top-up setting.
