[Unit]
Description=LoopBench private web application and inference gateway
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/loopbench

[Service]
Type=simple
User=loopbench
Group=loopbench
WorkingDirectory=/opt/loopbench/current
EnvironmentFile=/etc/loopbench/web.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/loopbench

[Install]
WantedBy=multi-user.target
