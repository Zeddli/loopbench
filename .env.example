# Never commit an API key. CLI children inherit the current shell environment.
# Keep paid inference disabled until you deliberately run the Nebius adapter.
NEBIUS_ALLOW_PAID=0
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Use the same absolute data path for CLI and web when launched in different directories.
# LOOPBENCH_HOME=D:/loopbench/.loopbench
